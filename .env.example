# Copy this file to .env for local development. Do not commit the populated .env file.
DJANGO_SECRET_KEY=generate-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# Canonical public frontend used in links published to Meta Commerce Manager.
META_CATALOG_STOREFRONT_URL=https://twinpeaksinvestment.com
PUBLIC_SITE_URL=https://twinpeaksinvestment.com

# MTN MoMo Collections sandbox. Never commit real values.
MOMO_ENVIRONMENT=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_CALLBACK_URL=
# MTN's sandbox uses EUR. Set SHOP_CURRENCY=EUR only for sandbox test data.
SHOP_CURRENCY=SZL
MOMO_CURRENCY=EUR

# Configure these only when testing email delivery locally.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TwinPeaks <info@twinpeaksinvestment.com>
BIRD_API_KEY=
